# Neon Postgres — pooled connection string (hostname includes "-pooler"),
# used at runtime by the app via @prisma/adapter-neon.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon Postgres — direct/unpooled connection string, used only for running
# migrations (prisma migrate dev / deploy).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Single shared admin password for the /admin portal (no user accounts).
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"

# Cloudflare R2 (player photo + team logo storage, S3-compatible). Create
# the bucket and a bucket-scoped API token in the Cloudflare dashboard →
# R2 → Manage API tokens. R2_ACCOUNT_ID is shown in the R2 overview sidebar.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="bfl-media"

# Hostname serving the bucket directly — a custom domain bound to the
# bucket in Cloudflare dashboard → R2 → bucket → Settings → Custom Domains.
# Files are served from Cloudflare's edge directly to the browser, so none
# of that bandwidth counts against Netlify.
R2_PUBLIC_URL="media.bfl.online.zahan.jp"

# Google Sheets live-standings backup (see netlify/functions/sync-sheets.mts
# and lib/sheetsSync.ts). Service account credentials from a JSON key
# downloaded in Google Cloud Console — the account itself must be given
# Editor access to the target sheet (a normal Share, not domain/API config).
# PRIVATE_KEY needs its real newlines escaped as literal "\n" — copy the
# private_key field from the JSON key file as-is, it's already escaped.
GOOGLE_SHEETS_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="the-id-from-the-sheet-url"
