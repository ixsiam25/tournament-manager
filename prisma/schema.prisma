generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoundType {
  LEAGUE
  SEMIFINAL
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum MatchEventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
}

enum Position {
  GK
  DEF
  MID
  FWD
}

model Team {
  id                  String   @id @default(cuid())
  name                String   @unique
  shortName           String?
  /// Which APU semester/batch this team represents (1-7+). Nullable because
  /// a team created by hand in admin has no batch to attach.
  semester            Int?
  managerName         String?
  logoUrl             String?
  managerPasswordHash String?
  managerLoginBlocked Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  players             Player[]
  homeMatches         Match[]              @relation("HomeTeam")
  awayMatches         Match[]              @relation("AwayTeam")
  events              MatchEvent[]
  predictions         Prediction[]
  championPredictions ChampionPrediction[]
}

/// Small key/value store for settings that need to be changeable from the
/// admin UI without an env var + redeploy (currently just the admin
/// password hash).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Player {
  id           String    @id @default(cuid())
  name         String
  jerseyNumber Int
  position     Position?
  isCaptain    Boolean   @default(false)
  photoUrl     String?
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events MatchEvent[]

  @@unique([teamId, jerseyNumber])
}

model Match {
  id               String      @id @default(cuid())
  round            RoundType
  label            String?
  homeTeamId       String?
  awayTeamId       String?
  homeTeam         Team?       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam         Team?       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  scheduledAt      DateTime?
  venue            String?
  mainReferee      String?
  assistantReferee String?
  status           MatchStatus @default(SCHEDULED)
  homeScore        Int         @default(0)
  awayScore        Int         @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  events      MatchEvent[]
  predictions Prediction[]

  @@index([status])
  @@index([round])
}

/// One audience vote for who wins a given match — the "who wins this game"
/// bar shown on the current/next match blocks. Anonymous but deduped per
/// browser via a client-generated voterId, so a visitor can change their
/// pick and it recalculates rather than double-counting.
model Prediction {
  id            String   @id @default(cuid())
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  voterId       String
  voterName     String?
  voterSemester String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([matchId, voterId])
  @@index([matchId])
}

/// One audience pick for who wins the whole season — the "Champions
/// Prediction" game on its own page. One pick per browser (voterId is
/// unique, not scoped to a match); submitting again overwrites it.
model ChampionPrediction {
  id            String   @id @default(cuid())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  voterId       String   @unique
  voterName     String?
  voterSemester String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MatchEvent {
  id        String         @id @default(cuid())
  matchId   String
  match     Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      MatchEventType
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id])
  playerId  String
  player    Player         @relation(fields: [playerId], references: [id])
  minute    Int?
  groupId   String
  sequence  Int            @default(autoincrement())
  createdAt DateTime       @default(now())

  @@index([matchId])
  @@index([groupId])
  @@index([playerId])
  @@index([type])
}
